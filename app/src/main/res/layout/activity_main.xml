<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F1E">

    <!-- WebView principale (index.html) — moitié haute -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/debugDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Séparateur debug -->
    <View
        android:id="@+id/debugDivider"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="#2563EB"
        app:layout_constraintTop_toBottomOf="@id/webView"
        app:layout_constraintBottom_toTopOf="@id/hiddenWebView"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Étiquette debug -->
    <TextView
        android:id="@+id/debugLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="▼ WebView RHTime (debug)"
        android:textColor="#2563EB"
        android:textSize="10sp"
        android:paddingStart="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/debugDivider" />

    <!-- WebView cachée (RHTime) — moitié basse -->
    <WebView
        android:id="@+id/hiddenWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/debugLabel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bouton flottant export -->
    <Button
        android:id="@+id/btnExportXml"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:text="Exporter ce mois"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:background="@drawable/btn_export_bg"
        android:elevation="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="28dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
