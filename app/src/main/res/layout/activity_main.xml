<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0F1E">

    <!-- WebView principale (index.html) — moitié haute -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Séparateur debug -->
    <TextView
        android:id="@+id/debugLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="▼ WebView RHTime (debug)"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:background="#2563EB"
        android:padding="6dp" />

    <!-- WebView RHTime — moitié basse -->
    <WebView
        android:id="@+id/hiddenWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
